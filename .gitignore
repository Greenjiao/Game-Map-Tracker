```text
# 忽略 Python 缓存
__pycache__/
*.pyc
*.pyo

# 忽略虚拟环境
venv/
env/

# 所有发布通道中的底图均不提交，由 Gitee Release 提供
**/maps/**/*.png
**/maps/**/*.jpg
**/maps/**/*.jpeg
**/maps/**/*.webp

# 测试通道不提交任何 PNG
/docs/test/**/*.png

# 忽略调试生成的图片
debug_minimap.png

# 忽略 IDE 配置文件
.idea/
.vscode/
.claude/
.trae/


# SIFT base-map descriptor cache (regenerated automatically on first launch)
.cache/

# 调试模式产物（仅 GMT_SIFT_DEBUG=1 时产生），不应入库
debug/

# 运行日志（崩溃日志、路线转换日志等），不应入库
logs/

# Build outputs
build/
dist/

# 对部分打包产物放行
!docs/test/**/*.pyd
!docs/update/**/*.pyd

routes/采样分析添加标注/采样分析添加标注1.json
routes_converted/采样分析添加标注1.json

# 发行脚本读取的本机私有运行时配置（含下发链接等），不应入库
runtime_config.json

# 许可证/激活码加密相关代码（私钥等不应入库）
auth/

# 下载脚本不提交
tools/download_map.py
